{
 "source": "/root/projects/tantraloka/texts-original/gretil_tantraloka.txt",
 "count": 333,
 "verses": [
  {
   "ref": "AbhT_1.1",
   "ahnika": 1,
   "verse": 1,
   "text": "tadubhayayāmalasphuritabhāvavisargamayaṃ hṛdayamanuttarāmṛtakulaṃ mama sasphuratāt //"
  },
  {
   "ref": "AbhT_1.2",
   "ahnika": 1,
   "verse": 2,
   "text": "mātṛmānaprameyāṃśaśūlāmbujakṛtāspadām //"
  },
  {
   "ref": "AbhT_1.3",
   "ahnika": 1,
   "verse": 3,
   "text": "prāvṛṇmeghaghanavyomavidyullekhāvilāsinīm //"
  },
  {
   "ref": "AbhT_1.4",
   "ahnika": 1,
   "verse": 4,
   "text": "stājjñānaśūlaṃ satpakṣavipakṣotkartanakṣamam //"
  },
  {
   "ref": "AbhT_1.5",
   "ahnika": 1,
   "verse": 5,
   "text": "tadeva devītrayamantarāstāmanuttaraṃ me prathayatsvarūpam //"
  },
  {
   "ref": "AbhT_1.6",
   "ahnika": 1,
   "verse": 6,
   "text": "devīsuto gaṇapatiḥ sphuradindukāntiḥ samyaksamucchalayatānmama saṃvidabdhim //"
  },
  {
   "ref": "AbhT_1.7",
   "ahnika": 1,
   "verse": 7,
   "text": "kalombhitaṃ bāhyapathe cakāra stānme sa macchandavibhuḥ prasannaḥ //"
  },
  {
   "ref": "AbhT_1.8",
   "ahnika": 1,
   "verse": 8,
   "text": "pūrve jayanti guravo guruśāstrasindhukallolakelikalanāmalakarṇadhārāḥ //"
  },
  {
   "ref": "AbhT_1.9",
   "ahnika": 1,
   "verse": 9,
   "text": "tadaparamūrtirbhagavān maheśvaro bhūtirājaśca //"
  },
  {
   "ref": "AbhT_1.10",
   "ahnika": 1,
   "verse": 10,
   "text": "jayanti saṃvidāmodasandarbhā dikprasarpiṇaḥ //"
  },
  {
   "ref": "AbhT_1.11",
   "ahnika": 1,
   "verse": 11,
   "text": "gurorlakṣmaṇaguptasya nādasaṃmohinīṃ numaḥ //"
  },
  {
   "ref": "AbhT_1.12",
   "ahnika": 1,
   "verse": 12,
   "text": "sa śrīcukhulako diśyādiṣṭaṃ me gururuttamaḥ //"
  },
  {
   "ref": "AbhT_1.13",
   "ahnika": 1,
   "verse": 13,
   "text": "yadudīritaśāsanāṃśubhirme prakaṭo@yaṃ gahano@pi śāstramārgaḥ //"
  },
  {
   "ref": "AbhT_1.14",
   "ahnika": 1,
   "verse": 14,
   "text": "anuttaraṣaḍardhārthakrame tvekāpi nekṣyate //"
  },
  {
   "ref": "AbhT_1.15",
   "ahnika": 1,
   "verse": 15,
   "text": "arthito racaye spaṣṭāṃ pūrṇārthā prakriyāmimām //"
  },
  {
   "ref": "AbhT_1.16",
   "ahnika": 1,
   "verse": 16,
   "text": "bodhānyapāśaviṣanuttadupāsanotthabodhojjvalo@bhinavagupta idaṃ karoti //"
  },
  {
   "ref": "AbhT_1.17",
   "ahnika": 1,
   "verse": 17,
   "text": "devadevena nirdiṣṭaṃ svaśabdenātha liṅgataḥ //"
  },
  {
   "ref": "AbhT_1.18",
   "ahnika": 1,
   "verse": 18,
   "text": "tatsāraṃ trikaśāstraṃ hi tatsāraṃ mālinīmatam //"
  },
  {
   "ref": "AbhT_1.19",
   "ahnika": 1,
   "verse": 19,
   "text": "adṛṣṭa prakaṭīkurmo gurunāthājñayā vayam //"
  },
  {
   "ref": "AbhT_1.20",
   "ahnika": 1,
   "verse": 20,
   "text": "trinayanacaraṇasaroruhacintanalabdhaprasiddhiriti //"
  },
  {
   "ref": "AbhT_1.21",
   "ahnika": 1,
   "verse": 21,
   "text": "abhinavaguptahṛdambujametadvicinuta maheśapūjanahetoḥ //"
  },
  {
   "ref": "AbhT_1.22",
   "ahnika": 1,
   "verse": 22,
   "text": "ajñānaṃ saṃsṛterheturjñānaṃ mokṣaikakāraṇam //"
  },
  {
   "ref": "AbhT_1.23",
   "ahnika": 1,
   "verse": 23,
   "text": "iti proktaṃ tathā va śrīmalinīvijayottare //"
  },
  {
   "ref": "AbhT_1.24",
   "ahnika": 1,
   "verse": 24,
   "text": "saṃbhāvanāṃ nirasyaitadabhāve mokṣamabravīt //"
  },
  {
   "ref": "AbhT_1.25",
   "ahnika": 1,
   "verse": 25,
   "text": "sa hi loṣṭādike@pyasti na ca tasyāsti saṃsṛtiḥ //"
  },
  {
   "ref": "AbhT_1.26",
   "ahnika": 1,
   "verse": 26,
   "text": "jñānameva tadajñānaṃ śivasūtreṣu bhāṣitam //"
  },
  {
   "ref": "AbhT_1.27",
   "ahnika": 1,
   "verse": 27,
   "text": "saṃśleṣetarayogāśyāmayamarthaḥ pradarśitaḥ //"
  },
  {
   "ref": "AbhT_1.28",
   "ahnika": 1,
   "verse": 28,
   "text": "anākṣipraviśeṣaṃ sadāha sūtre purātane //"
  },
  {
   "ref": "AbhT_1.29",
   "ahnika": 1,
   "verse": 29,
   "text": "bruvatā tasya cinmātrarūpasya dvaitamucyate //"
  },
  {
   "ref": "AbhT_1.30",
   "ahnika": 1,
   "verse": 30,
   "text": "tata eva samucchedyamityāvṛttyānirūpitam //"
  },
  {
   "ref": "AbhT_1.31",
   "ahnika": 1,
   "verse": 31,
   "text": "na mokṣo nāma tannāsya pṛthaṅnāmāpi gṛhyate //"
  },
  {
   "ref": "AbhT_1.32",
   "ahnika": 1,
   "verse": 32,
   "text": "taduttarottaraṃ jñānaṃ tattatsaṃsāraśāntidam //"
  },
  {
   "ref": "AbhT_1.33",
   "ahnika": 1,
   "verse": 33,
   "text": "itthaṃ samāsavyāsābhyāṃ jñānaṃ muñcati tāvataḥ //"
  },
  {
   "ref": "AbhT_1.34",
   "ahnika": 1,
   "verse": 34,
   "text": "amukta eva muktastu sarvāvacchedavarjitaḥ //"
  },
  {
   "ref": "AbhT_1.35",
   "ahnika": 1,
   "verse": 35,
   "text": "avacchedairna tatkutrāpyajñānaṃ satyamuktidam //"
  },
  {
   "ref": "AbhT_1.36",
   "ahnika": 1,
   "verse": 36,
   "text": "dvidhā pauruṣabauddhatvabhidoktaṃ śivaśāsane //"
  },
  {
   "ref": "AbhT_1.37",
   "ahnika": 1,
   "verse": 37,
   "text": "svapūrṇacitkriyārūpaśivatāvaraṇātmakam //"
  },
  {
   "ref": "AbhT_1.38",
   "ahnika": 1,
   "verse": 38,
   "text": "tadajñānaṃ na budghyaṃśo@dhyavasāyādyabhāvataḥ //"
  },
  {
   "ref": "AbhT_1.39",
   "ahnika": 1,
   "verse": 39,
   "text": "ṣaṭkañcukābilāṇūtthapratibimbanato yadā //"
  },
  {
   "ref": "AbhT_1.40",
   "ahnika": 1,
   "verse": 40,
   "text": "bauddhaṃ tasya ca tatpauṃsnaṃ poṣaṇīyaṃ ca poṣṭṛca //"
  },
  {
   "ref": "AbhT_1.41",
   "ahnika": 1,
   "verse": 41,
   "text": "vikasvaraṃ tadvijñānaṃ pauruṣaṃ nirvikalpakam //"
  },
  {
   "ref": "AbhT_1.42",
   "ahnika": 1,
   "verse": 42,
   "text": "tadbauddhaṃ yasya tatpauṃsnaṃ prāgvatpoṣyaṃ ca poṣṭṛ ca //"
  },
  {
   "ref": "AbhT_1.43",
   "ahnika": 1,
   "verse": 43,
   "text": "tathāpi taccharīrānte tajjñānaṃ vyajyate sphuṭam //"
  },
  {
   "ref": "AbhT_1.44",
   "ahnika": 1,
   "verse": 44,
   "text": "vilīyate tadā jīvanmuktiḥ karatale sthitā //"
  },
  {
   "ref": "AbhT_1.45",
   "ahnika": 1,
   "verse": 45,
   "text": "tena tatrāpi bauddhasya jñānasyāsti pradhānatā //"
  },
  {
   "ref": "AbhT_1.46",
   "ahnika": 1,
   "verse": 46,
   "text": "mataṅgādau kṛtaṃ śrīmatkheṭapālādidaiśikaiḥ //"
  },
  {
   "ref": "AbhT_1.47",
   "ahnika": 1,
   "verse": 47,
   "text": "śāstrameva pradhānaṃ yajjñeyatattvapradarśakam //"
  },
  {
   "ref": "AbhT_1.48",
   "ahnika": 1,
   "verse": 48,
   "text": "dhīgatasyānivṛttatvādvikalpo@pi hi saṃbhaveta //"
  },
  {
   "ref": "AbhT_1.49",
   "ahnika": 1,
   "verse": 49,
   "text": "dehānte@pi na mokṣaḥ syātpauruṣājñānahānitaḥ //"
  },
  {
   "ref": "AbhT_1.50",
   "ahnika": 1,
   "verse": 50,
   "text": "tadaiva mokṣa ityuktaṃ dhātrā śrīmanniśāṭane //"
  },
  {
   "ref": "AbhT_1.51",
   "ahnika": 1,
   "verse": 51,
   "text": "itarastu tadaiveti śāstrasyātra pradhānataḥ //"
  },
  {
   "ref": "AbhT_1.52",
   "ahnika": 1,
   "verse": 52,
   "text": "nahyaprakāśarūpasya prākāśyaṃ vastutāpi vā //"
  },
  {
   "ref": "AbhT_1.53",
   "ahnika": 1,
   "verse": 53,
   "text": "yatkuḍyasadṛśī neyaṃ dhīravastvetadityapi //"
  },
  {
   "ref": "AbhT_1.54",
   "ahnika": 1,
   "verse": 54,
   "text": "anapahnavanīyatvāt kiṃ tasminmānakalpanaiḥ //"
  },
  {
   "ref": "AbhT_1.55",
   "ahnika": 1,
   "verse": 55,
   "text": "teṣāmapi paro jīvaḥ sa eva parameśvaraḥ //"
  },
  {
   "ref": "AbhT_1.56",
   "ahnika": 1,
   "verse": 56,
   "text": "jñānamātmārthamityetanneti māṃ prati bhāsate //"
  },
  {
   "ref": "AbhT_1.57",
   "ahnika": 1,
   "verse": 57,
   "text": "yattatra ke pramāṇānāmupapattyupayogite //"
  },
  {
   "ref": "AbhT_1.58",
   "ahnika": 1,
   "verse": 58,
   "text": "[58 missing]//"
  },
  {
   "ref": "AbhT_1.59",
   "ahnika": 1,
   "verse": 59,
   "text": "tasya devātidevasya parāpekṣā na vidyate //"
  },
  {
   "ref": "AbhT_1.60",
   "ahnika": 1,
   "verse": 60,
   "text": "anapekṣasya vaśino deśakālākṛtikramāḥ //"
  },
  {
   "ref": "AbhT_1.61",
   "ahnika": 1,
   "verse": 61,
   "text": "vibhutvātsarvago nityabhāvādādyantavarjitaḥ //"
  },
  {
   "ref": "AbhT_1.62",
   "ahnika": 1,
   "verse": 62,
   "text": "tato@sya bahurūpatvamuktaṃ dīkṣottarādike //"
  },
  {
   "ref": "AbhT_1.63",
   "ahnika": 1,
   "verse": 63,
   "text": "bindunādādisaṃbhinnaḥ ṣaḍvidhaḥ śiva ucyate //"
  },
  {
   "ref": "AbhT_1.64",
   "ahnika": 1,
   "verse": 64,
   "text": "vyomādiśabdavijñānātparo mokṣo na saṃśayaḥ //"
  },
  {
   "ref": "AbhT_1.65",
   "ahnika": 1,
   "verse": 65,
   "text": "anavacchinnatārūḍhāvavacchedalaye@sya ca //"
  },
  {
   "ref": "AbhT_1.66",
   "ahnika": 1,
   "verse": 66,
   "text": "jaladarpaṇavattena sarvaṃ vyāptaṃ carācaram //"
  },
  {
   "ref": "AbhT_1.67",
   "ahnika": 1,
   "verse": 67,
   "text": "eka evāsya dharmo@sau sarvākṣepeṇa vartate //"
  },
  {
   "ref": "AbhT_1.68",
   "ahnika": 1,
   "verse": 68,
   "text": "bahuśaktitvamapyasya tacchaktyaivāviyuktatā //"
  },
  {
   "ref": "AbhT_1.69",
   "ahnika": 1,
   "verse": 69,
   "text": "tenādvayaḥ sa evāpi śaktimatparikalpane //"
  },
  {
   "ref": "AbhT_1.70",
   "ahnika": 1,
   "verse": 70,
   "text": "ko bhedo vastuto vahnerdagdhṛpaktṛtvayoriva //"
  },
  {
   "ref": "AbhT_1.71",
   "ahnika": 1,
   "verse": 71,
   "text": "nahyasti kiṃcittacchaktitadvadbhedo@pi vāstavaḥ //"
  },
  {
   "ref": "AbhT_1.72",
   "ahnika": 1,
   "verse": 72,
   "text": "śaktistadapi devyevaṃ bhāntyapyanyasvarūpiṇī //"
  },
  {
   "ref": "AbhT_1.73",
   "ahnika": 1,
   "verse": 73,
   "text": "svasaṃvinmātṛmakure svātantryādbhāvanādiṣu //"
  },
  {
   "ref": "AbhT_1.74",
   "ahnika": 1,
   "verse": 74,
   "text": "śaktirityeṣa vastveva śaktitadvatkramaḥ sphuṭaḥ //"
  },
  {
   "ref": "AbhT_1.75",
   "ahnika": 1,
   "verse": 75,
   "text": "anubhāvo vikalpo@pi mānaso na manaḥ śive //"
  },
  {
   "ref": "AbhT_1.76",
   "ahnika": 1,
   "verse": 76,
   "text": "kṣudhādyanubhavo naiva vikalpo nahi mānasaḥ //"
  },
  {
   "ref": "AbhT_1.77",
   "ahnika": 1,
   "verse": 77,
   "text": "vikalpo vetti tadvattu nādabindvādinā śivam //"
  },
  {
   "ref": "AbhT_1.78",
   "ahnika": 1,
   "verse": 78,
   "text": "kalātattvapurārṇāṇupadādirbhedavistaraḥ //"
  },
  {
   "ref": "AbhT_1.79",
   "ahnika": 1,
   "verse": 79,
   "text": "turyamityapi devasya bahuśaktitvajṛmbhitam //"
  },
  {
   "ref": "AbhT_1.80",
   "ahnika": 1,
   "verse": 80,
   "text": "tānyapyamuṣya nāthasya svātantryalaharībharaḥ //"
  },
  {
   "ref": "AbhT_1.81",
   "ahnika": 1,
   "verse": 81,
   "text": "akalau sakalaśceti śivasyaiva vibhūtayaḥ //"
  },
  {
   "ref": "AbhT_1.82",
   "ahnika": 1,
   "verse": 82,
   "text": "ātmaiva hi svabhāvātmetyuktaṃ śrītriśiromate //"
  },
  {
   "ref": "AbhT_1.83",
   "ahnika": 1,
   "verse": 83,
   "text": "sāmūhyaṃ caiva tattvānāṃ grāmaśabdena kīrtitam //"
  },
  {
   "ref": "AbhT_1.84",
   "ahnika": 1,
   "verse": 84,
   "text": "prakāśāvasthitaṃ jñānaṃ bhāvābhāvādimadhyataḥ //"
  },
  {
   "ref": "AbhT_1.85",
   "ahnika": 1,
   "verse": 85,
   "text": "viviktavastukathitaśuddhavijñānanirmalaḥ //"
  },
  {
   "ref": "AbhT_1.86",
   "ahnika": 1,
   "verse": 86,
   "text": "ūrdhva tyaktvādho viśetsa rāmastho madhyadeśagaḥ //"
  },
  {
   "ref": "AbhT_1.87",
   "ahnika": 1,
   "verse": 87,
   "text": "dhāvanaṃ plavanaṃ caiva āyāsaḥ śaktivedanam //"
  },
  {
   "ref": "AbhT_1.88",
   "ahnika": 1,
   "verse": 88,
   "text": "eṣa rāmo vyāpako@tra śivaḥ paramakāraṇam //"
  },
  {
   "ref": "AbhT_1.89",
   "ahnika": 1,
   "verse": 89,
   "text": "dhyāyate paramaṃ dhyeyaṃ gamāgamapade sthitam //"
  },
  {
   "ref": "AbhT_1.90",
   "ahnika": 1,
   "verse": 90,
   "text": "tatsvarūpaṃ japaḥ prokto bhāvābhāvapadacyutaḥ //"
  },
  {
   "ref": "AbhT_1.91",
   "ahnika": 1,
   "verse": 91,
   "text": "dūrāsannādiko bhedaścitsvātantryavyapekṣayā //"
  },
  {
   "ref": "AbhT_1.92",
   "ahnika": 1,
   "verse": 92,
   "text": "kena nāma na rūpeṇa bhāsate parameśvaraḥ //"
  },
  {
   "ref": "AbhT_1.93",
   "ahnika": 1,
   "verse": 93,
   "text": "āvṛtānāvṛto bhāti bahudhā bhedasaṃgamāt //"
  },
  {
   "ref": "AbhT_1.94",
   "ahnika": 1,
   "verse": 94,
   "text": "icchādibhirabhikhyābhirgurubhiḥ prakaṭīkṛtam //"
  },
  {
   "ref": "AbhT_1.95",
   "ahnika": 1,
   "verse": 95,
   "text": "mahābhairavadevo@yaṃ patiryaḥ paramaḥ śivaḥ //"
  },
  {
   "ref": "AbhT_1.96",
   "ahnika": 1,
   "verse": 96,
   "text": "savimarśatayā rava rūpataśca saṃsārabhīruhitakṛcca //"
  },
  {
   "ref": "AbhT_1.97",
   "ahnika": 1,
   "verse": 97,
   "text": "prakaṭībhūtaṃ bhavabhayavimarśanaṃ śaktipātato yena //"
  },
  {
   "ref": "AbhT_1.98",
   "ahnika": 1,
   "verse": 98,
   "text": "kālagrāsasamādhānarasikamanaḥsu teṣu ca prakaṭaḥ //"
  },
  {
   "ref": "AbhT_1.99",
   "ahnika": 1,
   "verse": 99,
   "text": "antarbahiścaturvidhakhecaryādikagaṇasyāpi //"
  },
  {
   "ref": "AbhT_1.100",
   "ahnika": 1,
   "verse": 100,
   "text": "bhairava iti gurubhirimairanvarthaiḥ saṃstutaḥ śāstre //"
  },
  {
   "ref": "AbhT_1.101",
   "ahnika": 1,
   "verse": 101,
   "text": "krīḍā sarvotkarṣeṇavartanecchā tathā svatantratvam //"
  },
  {
   "ref": "AbhT_1.102",
   "ahnika": 1,
   "verse": 102,
   "text": "nikhilāvabhāsanācca dyotanamasya stutiryataḥ sakalam //"
  },
  {
   "ref": "AbhT_1.103",
   "ahnika": 1,
   "verse": 103,
   "text": "bodhātmakaḥ samastakriyāmayo dṛkkriyāguṇaśca gatiḥ //"
  },
  {
   "ref": "AbhT_1.104",
   "ahnika": 1,
   "verse": 104,
   "text": "tena patiḥ śreyomaya eva śivo nāśivaṃ kimapi tatra //"
  },
  {
   "ref": "AbhT_1.105",
   "ahnika": 1,
   "verse": 105,
   "text": "tenāvacchedanude paramamahatpadaviśeṣaṇamupāttam //"
  },
  {
   "ref": "AbhT_1.106",
   "ahnika": 1,
   "verse": 106,
   "text": "mayā svasaṃvitsattarkapatiśāstratrikakramāt //"
  },
  {
   "ref": "AbhT_1.107",
   "ahnika": 1,
   "verse": 107,
   "text": "sṛṣṭau sthitau laye turye tenaitā dvādaśoditāḥ //"
  },
  {
   "ref": "AbhT_1.108",
   "ahnika": 1,
   "verse": 108,
   "text": "tenātropāsakāḥ sākṣāttatraiva pariniṣṭhitāḥ //"
  },
  {
   "ref": "AbhT_1.109",
   "ahnika": 1,
   "verse": 109,
   "text": "tatsvātantryabalādeva śāstreṣu paribhāṣitam //"
  },
  {
   "ref": "AbhT_1.110",
   "ahnika": 1,
   "verse": 110,
   "text": "pañcamūrtiḥ ṣaḍātmāyaṃ saptako@ṣṭakabhūṣitaḥ //"
  },
  {
   "ref": "AbhT_1.111",
   "ahnika": 1,
   "verse": 111,
   "text": "dvādaśāramahācakranāyako bhairavastviti //"
  },
  {
   "ref": "AbhT_1.112",
   "ahnika": 1,
   "verse": 112,
   "text": "viśvacakre maheśāno viśvaśaktirvijṛmbhate //"
  },
  {
   "ref": "AbhT_1.113",
   "ahnika": 1,
   "verse": 113,
   "text": "aikyena cakrago bhedastatra tatra nirūpitaḥ //"
  },
  {
   "ref": "AbhT_1.114",
   "ahnika": 1,
   "verse": 114,
   "text": "ṣaṭcakreśvaratā nāthasyoktā citranijākṛteḥ //"
  },
  {
   "ref": "AbhT_1.115",
   "ahnika": 1,
   "verse": 115,
   "text": "saumyaraudrākṛtidhyānayogīnyanvarthakalpanāt //"
  },
  {
   "ref": "AbhT_1.116",
   "ahnika": 1,
   "verse": 116,
   "text": "saumyaṃ vānyanmitaṃ saṃvidūrmicakramupāsyate //"
  },
  {
   "ref": "AbhT_1.117",
   "ahnika": 1,
   "verse": 117,
   "text": "dhyānātsaṃjalpasaṃmiśrād vyāpārāccāpi bāhyataḥ //"
  },
  {
   "ref": "AbhT_1.118",
   "ahnika": 1,
   "verse": 118,
   "text": "puṣṭiḥ śuṣkasya sarasībhāvo jalamataḥ sitam //"
  },
  {
   "ref": "AbhT_1.119",
   "ahnika": 1,
   "verse": 119,
   "text": "ye ca svabhāvato varṇā rasaniḥṣyandino yathā //"
  },
  {
   "ref": "AbhT_1.120",
   "ahnika": 1,
   "verse": 120,
   "text": "taṃ bījabhāvamāgatya saṃvidaṃ sphuṭayanti tām //"
  },
  {
   "ref": "AbhT_1.121",
   "ahnika": 1,
   "verse": 121,
   "text": "saṃjalpo@pi vikalpātmā kiṃ tāmeva na pūrayet //"
  },
  {
   "ref": "AbhT_1.122",
   "ahnika": 1,
   "verse": 122,
   "text": "tenāsya bījaṃ puṣṇīyāmityenāṃ pūrayetkriyām //"
  },
  {
   "ref": "AbhT_1.123",
   "ahnika": 1,
   "verse": 123,
   "text": "avacchedānavacchidbhyāṃ bhogamokṣārthibhirjanaiḥ //"
  },
  {
   "ref": "AbhT_1.124",
   "ahnika": 1,
   "verse": 124,
   "text": "ye bodhādvyatiriktaṃ hi kiṃcidyājyatayā viduḥ //"
  },
  {
   "ref": "AbhT_1.125",
   "ahnika": 1,
   "verse": 125,
   "text": "tenāvicchinnatāmarśarūpāhantāprathātmanaḥ //"
  },
  {
   "ref": "AbhT_1.126",
   "ahnika": 1,
   "verse": 126,
   "text": "vedyā hi devatāsṛṣṭiḥ śakterhetoḥ samutthitā //"
  },
  {
   "ref": "AbhT_1.127",
   "ahnika": 1,
   "verse": 127,
   "text": "vidhirniyogastryaṃśā ca bhāvanā codanātmikā //"
  },
  {
   "ref": "AbhT_1.128",
   "ahnika": 1,
   "verse": 128,
   "text": "ahaṃbodhastu na tathā te tu saṃvedyarūpatām //"
  },
  {
   "ref": "AbhT_1.129",
   "ahnika": 1,
   "verse": 129,
   "text": "taduktaṃ na vidurmāṃ tu tattvenātaścalanti te //"
  },
  {
   "ref": "AbhT_1.130",
   "ahnika": 1,
   "verse": 130,
   "text": "devāndevayajo yāntītyādi tena nyarūpyata //"
  },
  {
   "ref": "AbhT_1.131",
   "ahnika": 1,
   "verse": 131,
   "text": "viduste hyanavacchinnaṃ tadbhaktā api yānti mām //"
  },
  {
   "ref": "AbhT_1.132",
   "ahnika": 1,
   "verse": 132,
   "text": "sa bhoktṛprabhuśabdābhyāṃ yājyayaṣṭṭatayoditaḥ //"
  },
  {
   "ref": "AbhT_1.133",
   "ahnika": 1,
   "verse": 133,
   "text": "na tvākṛtiḥ kuto@pyanyā devatā na hi socitā //"
  },
  {
   "ref": "AbhT_1.134",
   "ahnika": 1,
   "verse": 134,
   "text": "so@yamātmānamāvṛtya sthito jaḍapadaṃ gataḥ //"
  },
  {
   "ref": "AbhT_1.135",
   "ahnika": 1,
   "verse": 135,
   "text": "jaḍājaḍasyāpyetasya dvairūpyasyāsti citratā //"
  },
  {
   "ref": "AbhT_1.136",
   "ahnika": 1,
   "verse": 136,
   "text": "jñeyabhāvo hi ciddharmastacchāyācchādayenna tām // 136c /"
  },
  {
   "ref": "AbhT_1.137",
   "ahnika": 1,
   "verse": 137,
   "text": "anāvaraṇabhāgāṃśe vaicitryaṃ bahudhā sthitam //"
  },
  {
   "ref": "AbhT_1.138",
   "ahnika": 1,
   "verse": 138,
   "text": "tathāpyāvṛtinirhāsatāratamyātsa lakṣyate //"
  },
  {
   "ref": "AbhT_1.139",
   "ahnika": 1,
   "verse": 139,
   "text": "samāpya paratāṃ sthaulyaprasaṃge carcayiṣyate //"
  },
  {
   "ref": "AbhT_1.140",
   "ahnika": 1,
   "verse": 140,
   "text": "pūrṇameva nijaṃ rūpaṃ kaṃcidaṃśāṃśikākramāt //"
  },
  {
   "ref": "AbhT_1.141",
   "ahnika": 1,
   "verse": 141,
   "text": "aṇūnāṃ tatparaṃ jñānaṃ tadanyadaparaṃ bahu //"
  },
  {
   "ref": "AbhT_1.142",
   "ahnika": 1,
   "verse": 142,
   "text": "prathamānaṃ vicitrābhirbhaṃgībhiriha bhidyate //"
  },
  {
   "ref": "AbhT_1.143",
   "ahnika": 1,
   "verse": 143,
   "text": "vyavadhānāvyavadhinā bhūyānbhedaḥ pravartate //"
  },
  {
   "ref": "AbhT_1.144",
   "ahnika": 1,
   "verse": 144,
   "text": "jñānameva tu tatsūkṣmaṃ paraṃ tvicchātmakaṃ matam //"
  },
  {
   "ref": "AbhT_1.145",
   "ahnika": 1,
   "verse": 145,
   "text": "eṣaiva ca kriyāśaktirbandhamokṣaikakāraṇam //"
  },
  {
   "ref": "AbhT_1.146",
   "ahnika": 1,
   "verse": 146,
   "text": "yatsphuretprakaṭaṃ sākṣāttadicchākhyaṃ prakīrtitam //"
  },
  {
   "ref": "AbhT_1.147",
   "ahnika": 1,
   "verse": 147,
   "text": "bhāti bhāvaḥ sphuṭastadvatkeṣāmapi śivātmatā //"
  },
  {
   "ref": "AbhT_1.148",
   "ahnika": 1,
   "verse": 148,
   "text": "yatparāmarśamabhyeti jñānopāyaṃ tu tadviduḥ //"
  },
  {
   "ref": "AbhT_1.149",
   "ahnika": 1,
   "verse": 149,
   "text": "kriyopāyaṃ tadāmnātaṃ bhedo nātrāpavargagaḥ //"
  },
  {
   "ref": "AbhT_1.150",
   "ahnika": 1,
   "verse": 150,
   "text": "rūḍheryogāntatāṃ prāptamiti śrīgamaśāsane //"
  },
  {
   "ref": "AbhT_1.151",
   "ahnika": 1,
   "verse": 151,
   "text": "svacittavāsanāśāntau sā kriyetyabhidhīyate //"
  },
  {
   "ref": "AbhT_1.152",
   "ahnika": 1,
   "verse": 152,
   "text": "tāsāṃ śāntinimittaṃ yā matiḥ saṃvitsvabhāvikā //"
  },
  {
   "ref": "AbhT_1.153",
   "ahnika": 1,
   "verse": 153,
   "text": "kriyā saiva ca yogaḥ syāttattvānāṃ cillayīkṛtau //"
  },
  {
   "ref": "AbhT_1.154",
   "ahnika": 1,
   "verse": 154,
   "text": "sā dehaṃ deśamakṣāṃścāpyāviśantī gatikriyā //"
  },
  {
   "ref": "AbhT_1.155",
   "ahnika": 1,
   "verse": 155,
   "text": "jñānameva vimokṣāya yuktaṃ caitadudāhṛtam //"
  },
  {
   "ref": "AbhT_1.156",
   "ahnika": 1,
   "verse": 156,
   "text": "svarūpaṃ cātmanaḥ saṃvinnānyattatra tu yāḥ punaḥ //"
  },
  {
   "ref": "AbhT_1.157",
   "ahnika": 1,
   "verse": 157,
   "text": "asaṃvidrūpatāyogāddharmiṇaścānirūpaṇāt //"
  },
  {
   "ref": "AbhT_1.158",
   "ahnika": 1,
   "verse": 158,
   "text": "śaktīnāṃ dharmarūpāṇāmāśrayaḥ ko@pi kathyate //"
  },
  {
   "ref": "AbhT_1.159",
   "ahnika": 1,
   "verse": 159,
   "text": "ekaḥ śiva itīyaṃ vāgvastuśūnyaiva jāyate //"
  },
  {
   "ref": "AbhT_1.160",
   "ahnika": 1,
   "verse": 160,
   "text": "vivicyamānaṃ bahvīṣu paryavasyati śaktiṣu //"
  },
  {
   "ref": "AbhT_1.161",
   "ahnika": 1,
   "verse": 161,
   "text": "nāvaśyaṃ kāraṇātkārya tajjñānyapi na mucyate //"
  },
  {
   "ref": "AbhT_1.162",
   "ahnika": 1,
   "verse": 162,
   "text": "na sā mukhyā tato nāyaṃ prasaṃga iti niścitam //"
  },
  {
   "ref": "AbhT_1.163",
   "ahnika": 1,
   "verse": 163,
   "text": "yato vahati tenāsyāṃ citratā dṛśyatāṃ kila //"
  },
  {
   "ref": "AbhT_1.164",
   "ahnika": 1,
   "verse": 164,
   "text": "bhedopabhedavaividhyānniḥsaṃkhyatvamavāntarāt //"
  },
  {
   "ref": "AbhT_1.165",
   "ahnika": 1,
   "verse": 165,
   "text": "upāyabhedānmokṣe@pi bhedaḥ syāditi sūrayaḥ //"
  },
  {
   "ref": "AbhT_1.166",
   "ahnika": 1,
   "verse": 166,
   "text": "hetubhede@pi no bhinnā ghaṭadhvaṃsādivṛttivat //"
  },
  {
   "ref": "AbhT_1.167",
   "ahnika": 1,
   "verse": 167,
   "text": "ādeśi parameśitrā samāveśavinirṇaye //"
  },
  {
   "ref": "AbhT_1.168",
   "ahnika": 1,
   "verse": 168,
   "text": "utpadyate ya āveśaḥ śāmbhavo@sāvidīritaḥ //"
  },
  {
   "ref": "AbhT_1.169",
   "ahnika": 1,
   "verse": 169,
   "text": "yaṃ samāveśamāpnoti śāktaḥ so@trābhidhīyate //"
  },
  {
   "ref": "AbhT_1.170",
   "ahnika": 1,
   "verse": 170,
   "text": "yo bhavetsa samāveśaḥ samyagāṇava ucyate //"
  },
  {
   "ref": "AbhT_1.171",
   "ahnika": 1,
   "verse": 171,
   "text": "tayā ca jhaṭiti jñeyasamāpattirnirūpyate //"
  },
  {
   "ref": "AbhT_1.172",
   "ahnika": 1,
   "verse": 172,
   "text": "jñeyābhimukhabodhena drākprarūḍhatvaśālinā //"
  },
  {
   "ref": "AbhT_1.173",
   "ahnika": 1,
   "verse": 173,
   "text": "āveśaścāsvatantrasya svatadrūpanimajjanāt //"
  },
  {
   "ref": "AbhT_1.174",
   "ahnika": 1,
   "verse": 174,
   "text": "tenāyamatra vākyārtho vijñeyaṃ pronmiṣatsvayam //"
  },
  {
   "ref": "AbhT_1.175",
   "ahnika": 1,
   "verse": 175,
   "text": "mātāramadharīkurvat svāṃ vibhūtiṃ pradarśayat //"
  },
  {
   "ref": "AbhT_1.176",
   "ahnika": 1,
   "verse": 176,
   "text": "jñeyaṃ dvidhā ca cinmātraṃ jaḍaṃ cādyaṃ ca kalpitam //"
  },
  {
   "ref": "AbhT_1.177",
   "ahnika": 1,
   "verse": 177,
   "text": "jaḍena yaḥ samāveśaḥ sapraticchandakākṛtiḥ //"
  },
  {
   "ref": "AbhT_1.178",
   "ahnika": 1,
   "verse": 178,
   "text": "tenāvikalpā saṃvittirbhāvanādyanapekṣiṇī //"
  },
  {
   "ref": "AbhT_1.179",
   "ahnika": 1,
   "verse": 179,
   "text": "tatprasādātpunaḥ paścādbhāvino@tra viniścayāḥ //"
  },
  {
   "ref": "AbhT_1.180",
   "ahnika": 1,
   "verse": 180,
   "text": "vikalpāpekṣayā mānamavikalpamiti bruvan //"
  },
  {
   "ref": "AbhT_1.181",
   "ahnika": 1,
   "verse": 181,
   "text": "gṛhītamiti suspaṣṭā niścayasya yataḥ prathā //"
  },
  {
   "ref": "AbhT_1.182",
   "ahnika": 1,
   "verse": 182,
   "text": "avikalpātmasaṃvittau yā sphurattaiva vastunaḥ //"
  },
  {
   "ref": "AbhT_1.183",
   "ahnika": 1,
   "verse": 183,
   "text": "kevalaṃ saṃvidaḥ so@yaṃ nairmalyetaraviśramaḥ //"
  },
  {
   "ref": "AbhT_1.184",
   "ahnika": 1,
   "verse": 184,
   "text": "niśīthe@pi maṇijñānī vidyutkālapradarśitān //"
  },
  {
   "ref": "AbhT_1.185",
   "ahnika": 1,
   "verse": 185,
   "text": "nairmalyaṃ saṃvidaścedaṃ pūrvābhyāsavaśādatho //"
  },
  {
   "ref": "AbhT_1.186",
   "ahnika": 1,
   "verse": 186,
   "text": "pañcāśadvidhatā cāsya samāveśasya varṇitā //"
  },
  {
   "ref": "AbhT_1.187",
   "ahnika": 1,
   "verse": 187,
   "text": "etattattvāntare yatpuṃvidyāśaktyātmakaṃ trayam //"
  },
  {
   "ref": "AbhT_1.188",
   "ahnika": 1,
   "verse": 188,
   "text": "puṃvidyāśaktisaṃjñaṃ yattatsarvavyāpakaṃ yataḥ //"
  },
  {
   "ref": "AbhT_1.189",
   "ahnika": 1,
   "verse": 189,
   "text": "aśuddhiśuddhyamānatvaśuddhitastu mitho@pi tat //"
  },
  {
   "ref": "AbhT_1.190",
   "ahnika": 1,
   "verse": 190,
   "text": "tattvavargātpṛthagbhūtasamākhyānyata eva hi //"
  },
  {
   "ref": "AbhT_1.191",
   "ahnika": 1,
   "verse": 191,
   "text": "viduścatuṣṭaye cātra sāvakāśe tadāsthitim //"
  },
  {
   "ref": "AbhT_1.192",
   "ahnika": 1,
   "verse": 192,
   "text": "ko@vakāśo bhavettatra bhautāveśādivarṇane //"
  },
  {
   "ref": "AbhT_1.193",
   "ahnika": 1,
   "verse": 193,
   "text": "nāsmākaṃ mānasāvarjī loko bhinnaruciryataḥ //"
  },
  {
   "ref": "AbhT_1.194",
   "ahnika": 1,
   "verse": 194,
   "text": "bhūtādīnāṃ yathā sātra na tathā dvayavarjite //"
  },
  {
   "ref": "AbhT_1.195",
   "ahnika": 1,
   "verse": 195,
   "text": "etāvatī mahādevī rudraśaktiranargalā //"
  },
  {
   "ref": "AbhT_1.196",
   "ahnika": 1,
   "verse": 196,
   "text": "dharāderviśvarūpatvaṃ pāñcadaśyādibhedataḥ //"
  },
  {
   "ref": "AbhT_1.197",
   "ahnika": 1,
   "verse": 197,
   "text": "niraṃśabhāvasaṃbodhastathaivātrāpi budhyatām //"
  },
  {
   "ref": "AbhT_1.198",
   "ahnika": 1,
   "verse": 198,
   "text": "anyairvā śaktirūpatvāddharmaiḥ svasamavāyibhiḥ //"
  },
  {
   "ref": "AbhT_1.199",
   "ahnika": 1,
   "verse": 199,
   "text": "upāsate vikalpaughasaṃskārādye śrutotthitāt //"
  },
  {
   "ref": "AbhT_1.200",
   "ahnika": 1,
   "verse": 200,
   "text": "dharmiṇaṃ pūrṇadharmaughamabhedenādhiśerate //"
  },
  {
   "ref": "AbhT_1.201",
   "ahnika": 1,
   "verse": 201,
   "text": "antarullikhitacitrasaṃvido no bhaveyuranubhūtayaḥ sphuṭāḥ //"
  },
  {
   "ref": "AbhT_1.202",
   "ahnika": 1,
   "verse": 202,
   "text": "atha patyuradhiṣṭhānamityādyuktaṃ viśeṣaṇaiḥ //"
  },
  {
   "ref": "AbhT_1.203",
   "ahnika": 1,
   "verse": 203,
   "text": "kāṣṭhā saiva parā sūkṣmā sarvadikkāmṛtātmikā //"
  },
  {
   "ref": "AbhT_1.204",
   "ahnika": 1,
   "verse": 204,
   "text": "ādyantoparatā sādhvī mūrtitvenopacaryate //"
  },
  {
   "ref": "AbhT_1.205",
   "ahnika": 1,
   "verse": 205,
   "text": "tanmukhā sphuṭatā dharmiṇyāśu tanmayatāsthitiḥ //"
  },
  {
   "ref": "AbhT_1.206",
   "ahnika": 1,
   "verse": 206,
   "text": "ākāraiḥ paryupāsyante tanmayībhāvasiddhaye //"
  },
  {
   "ref": "AbhT_1.207",
   "ahnika": 1,
   "verse": 207,
   "text": "ākṣipeddhavatāsattvanyāyāddūrāntikatvataḥ //"
  },
  {
   "ref": "AbhT_1.208",
   "ahnika": 1,
   "verse": 208,
   "text": "bhairavatvaṃ viśvaśaktīrākṣipedvyāpakatvataḥ //"
  },
  {
   "ref": "AbhT_1.209",
   "ahnika": 1,
   "verse": 209,
   "text": "śaktīḥ samākṣipeyustadupāsāntikadūrataḥ //"
  },
  {
   "ref": "AbhT_1.210",
   "ahnika": 1,
   "verse": 210,
   "text": "iha tūkto yatastasmāt pratiyogyavikalpakam //"
  },
  {
   "ref": "AbhT_1.211",
   "ahnika": 1,
   "verse": 211,
   "text": "dharāsadāśivāntena tena tena śivībhavet //"
  },
  {
   "ref": "AbhT_1.212",
   "ahnika": 1,
   "verse": 212,
   "text": "prakāśe tanmukhenaiva saṃvitparaśivātmatā //"
  },
  {
   "ref": "AbhT_1.213",
   "ahnika": 1,
   "verse": 213,
   "text": "śāmbhavākhyaṃ samāveśaṃ sumatyantenivāsinaḥ //"
  },
  {
   "ref": "AbhT_1.214",
   "ahnika": 1,
   "verse": 214,
   "text": "savikalpatayā māyāmayamicchādi vastutaḥ //"
  },
  {
   "ref": "AbhT_1.215",
   "ahnika": 1,
   "verse": 215,
   "text": "śāktaḥ sa māyopāyo@pi tadante nirvikalpakaḥ //"
  },
  {
   "ref": "AbhT_1.216",
   "ahnika": 1,
   "verse": 216,
   "text": "apūrṇā mātṛdaurātmyāttadapāye vikasvarā //"
  },
  {
   "ref": "AbhT_1.217",
   "ahnika": 1,
   "verse": 217,
   "text": "yasyāṃ sphuṭe paraṃ tvasyāṃ saṃkocaḥ pūrvanītitaḥ //"
  },
  {
   "ref": "AbhT_1.218",
   "ahnika": 1,
   "verse": 218,
   "text": "sā yatheṣṭāntarābhāsakāriṇī śaktirujjvalā //"
  },
  {
   "ref": "AbhT_1.219",
   "ahnika": 1,
   "verse": 219,
   "text": "anyopāyātra tūccārarahitatvaṃ nyarūpayat //"
  },
  {
   "ref": "AbhT_1.220",
   "ahnika": 1,
   "verse": 220,
   "text": "śaktyupāye na santyete bhedābhedau hi śaktitā //"
  },
  {
   "ref": "AbhT_1.221",
   "ahnika": 1,
   "verse": 221,
   "text": "vikalpaniścayātmaiva paryante nirvikalpakaḥ //"
  },
  {
   "ref": "AbhT_1.222",
   "ahnika": 1,
   "verse": 222,
   "text": "nādhovartitayā tena kathitaṃ kathamīdṛśam //"
  },
  {
   "ref": "AbhT_1.223",
   "ahnika": 1,
   "verse": 223,
   "text": "svarūpagopanaṃ kṛtvā svaprakāśaḥ punastathā //"
  },
  {
   "ref": "AbhT_1.224",
   "ahnika": 1,
   "verse": 224,
   "text": "adhovyāptuḥ śivasyaiva sa prakāśo vyavasthitaḥ //"
  },
  {
   "ref": "AbhT_1.225",
   "ahnika": 1,
   "verse": 225,
   "text": "yena buddhi-manobhūmāvapi bhāti paraṃ padam //"
  },
  {
   "ref": "AbhT_1.226",
   "ahnika": 1,
   "verse": 226,
   "text": "prayāta eva tadrūḍhiṃ vinā naiva hi kiṃcana //"
  },
  {
   "ref": "AbhT_1.227",
   "ahnika": 1,
   "verse": 227,
   "text": "kalpanāyāśca mukhyatvamatraiva kila sūcitam //"
  },
  {
   "ref": "AbhT_1.228",
   "ahnika": 1,
   "verse": 228,
   "text": "tadvikalpakramopāttanirvikalpapramāṇatā //"
  },
  {
   "ref": "AbhT_1.229",
   "ahnika": 1,
   "verse": 229,
   "text": "anupāyāvikalpāptau ratnajña iti bhaṇyate //"
  },
  {
   "ref": "AbhT_1.230",
   "ahnika": 1,
   "verse": 230,
   "text": "bhedābhedātmakopāyaṃ bhedopāyaṃ tadāṇavam //"
  },
  {
   "ref": "AbhT_1.231",
   "ahnika": 1,
   "verse": 231,
   "text": "prasphuṭenaiva rūpeṇa bhāvī so@ntarbhaviṣyati //"
  },
  {
   "ref": "AbhT_1.232",
   "ahnika": 1,
   "verse": 232,
   "text": "upāyavaśataḥ prāptaṃ tatkriyeti puroditam //"
  },
  {
   "ref": "AbhT_1.233",
   "ahnika": 1,
   "verse": 233,
   "text": "yato hi kalpanāmātraṃ svaparādivibhūtayaḥ //"
  },
  {
   "ref": "AbhT_1.234",
   "ahnika": 1,
   "verse": 234,
   "text": "guruḥ sa tāvadekātmā siddho muktaśca bhaṇyate //"
  },
  {
   "ref": "AbhT_1.235",
   "ahnika": 1,
   "verse": 235,
   "text": "samyagjñānamayaśceti svātmanā mucyate tataḥ //"
  },
  {
   "ref": "AbhT_1.236",
   "ahnika": 1,
   "verse": 236,
   "text": "yuktyāgamābhyāṃ saṃsiddhaṃ tāvāneko yato muniḥ //"
  },
  {
   "ref": "AbhT_1.237",
   "ahnika": 1,
   "verse": 237,
   "text": "dīkṣādikā kriyā ceyaṃ sā kathaṃ muktaye bhavet //"
  },
  {
   "ref": "AbhT_1.238",
   "ahnika": 1,
   "verse": 238,
   "text": "iti te mūlataḥ kṣiptā yattvatrānyaiḥ samarthitam //"
  },
  {
   "ref": "AbhT_1.239",
   "ahnika": 1,
   "verse": 239,
   "text": "tadvihantrī kriyā dīkṣā tvañjanādikakarmavat //"
  },
  {
   "ref": "AbhT_1.240",
   "ahnika": 1,
   "verse": 240,
   "text": "malamāyākarmaṇāṃ ca darśayiṣyāmahe sthitim //"
  },
  {
   "ref": "AbhT_1.241",
   "ahnika": 1,
   "verse": 241,
   "text": "mūlaṃ taduttaraṃ madhyamuttarottaramādimam //"
  },
  {
   "ref": "AbhT_1.242",
   "ahnika": 1,
   "verse": 242,
   "text": "ānandaśaktiviśrāntamanuttaramihocyate //"
  },
  {
   "ref": "AbhT_1.243",
   "ahnika": 1,
   "verse": 243,
   "text": "api durlabhasadbhāvaṃ śrīsiddhātantra ucyate //"
  },
  {
   "ref": "AbhT_1.244",
   "ahnika": 1,
   "verse": 244,
   "text": "na caitadaprasannena śaṃkareṇeti vākyataḥ //"
  },
  {
   "ref": "AbhT_1.245",
   "ahnika": 1,
   "verse": 245,
   "text": "tanmayā tantryate tantrālokanāmnyatra śāsane //"
  },
  {
   "ref": "AbhT_1.246",
   "ahnika": 1,
   "verse": 246,
   "text": "anudghāṭitarūpaṃ tatpūrvameva prakāśate //"
  },
  {
   "ref": "AbhT_1.247",
   "ahnika": 1,
   "verse": 247,
   "text": "saṃśayaḥ kutracidrūpe niścite sati nānyathā //"
  },
  {
   "ref": "AbhT_1.248",
   "ahnika": 1,
   "verse": 248,
   "text": "saṃśayo@stitvanāstyādidharmānudghāṭitātmakaḥ //"
  },
  {
   "ref": "AbhT_1.249",
   "ahnika": 1,
   "verse": 249,
   "text": "kiṃ tvanunmudritākāraṃ vastvevābhidadhātyayam //"
  },
  {
   "ref": "AbhT_1.250",
   "ahnika": 1,
   "verse": 250,
   "text": "bhūyaḥsthadharmajāteṣu niścayotpāda eva hi //"
  },
  {
   "ref": "AbhT_1.251",
   "ahnika": 1,
   "verse": 251,
   "text": "saṃśayaḥ sa kimityaṃśe vikalpastvanyathā sphuṭaḥ //"
  },
  {
   "ref": "AbhT_1.252",
   "ahnika": 1,
   "verse": 252,
   "text": "prathamaṃ sa ihoddeśaḥ praśnaḥ saṃśaya eva ca //"
  },
  {
   "ref": "AbhT_1.253",
   "ahnika": 1,
   "verse": 253,
   "text": "prasarantī svasaṃvittiḥ praṣṭrī śiṣyātmatāṃ gatā //"
  },
  {
   "ref": "AbhT_1.254",
   "ahnika": 1,
   "verse": 254,
   "text": "prasarānantarodbhūtasaṃhārodayabhāgapi //"
  },
  {
   "ref": "AbhT_1.255",
   "ahnika": 1,
   "verse": 255,
   "text": "anunmīlitarūpā sā praṣṭrī tāvati bhaṇyate //"
  },
  {
   "ref": "AbhT_1.256",
   "ahnika": 1,
   "verse": 256,
   "text": "guruśiṣyapade@pyeṣa dehabhedo hyatāttvikaḥ //"
  },
  {
   "ref": "AbhT_1.257",
   "ahnika": 1,
   "verse": 257,
   "text": "bahirābhāsayatyeva drāksāmānyaviśeṣataḥ //"
  },
  {
   "ref": "AbhT_1.258",
   "ahnika": 1,
   "verse": 258,
   "text": "dharmasya sṛṣṭiḥ sāmānyasṛṣṭiḥ sā saṃśayātmikā //"
  },
  {
   "ref": "AbhT_1.259",
   "ahnika": 1,
   "verse": 259,
   "text": "nirṇayo mātṛrucito nānyathā kalpakoṭibhiḥ //"
  },
  {
   "ref": "AbhT_1.260",
   "ahnika": 1,
   "verse": 260,
   "text": "unmudraṇaṃ tayākṛtyā lakṣaṇottaranirṇayāḥ //"
  },
  {
   "ref": "AbhT_1.261",
   "ahnika": 1,
   "verse": 261,
   "text": "bhūyo bhūyaḥ samuddeśalakṣaṇātmaparīkṣaṇam //"
  },
  {
   "ref": "AbhT_1.262",
   "ahnika": 1,
   "verse": 262,
   "text": "uddeśalakṣaṇāvekṣātritayaṃ prāṇināṃ sphuret //"
  },
  {
   "ref": "AbhT_1.263",
   "ahnika": 1,
   "verse": 263,
   "text": "parīkṣaṇaṃ tathādhyakṣe vikalpānāṃ paramparā //"
  },
  {
   "ref": "AbhT_1.264",
   "ahnika": 1,
   "verse": 264,
   "text": "lakṣyaṃ vyāptyādivijñānajālaṃ tvatra parīkṣaṇam //"
  },
  {
   "ref": "AbhT_1.265",
   "ahnika": 1,
   "verse": 265,
   "text": "iti vā lakṣaṇaṃ śeṣaḥ parīkṣopamitau bhavet //"
  },
  {
   "ref": "AbhT_1.266",
   "ahnika": 1,
   "verse": 266,
   "text": "agniṣṭomādinetyeṣā parīkṣā śeṣavartinī //"
  },
  {
   "ref": "AbhT_1.267",
   "ahnika": 1,
   "verse": 267,
   "text": "vastuno yā tathātvena sṛṣṭiḥ soddeśasaṃjñitā //"
  },
  {
   "ref": "AbhT_1.268",
   "ahnika": 1,
   "verse": 268,
   "text": "yato hyakālakalitā saṃdhatte sārvakālikam //"
  },
  {
   "ref": "AbhT_1.269",
   "ahnika": 1,
   "verse": 269,
   "text": "anūdyamāne dharme sā saṃvillakṣaṇamucyate //"
  },
  {
   "ref": "AbhT_1.270",
   "ahnika": 1,
   "verse": 270,
   "text": "parīkṣā kathyate mātṛrucitā kalpitāvadhiḥ //"
  },
  {
   "ref": "AbhT_1.271",
   "ahnika": 1,
   "verse": 271,
   "text": "parā parāparā devī caramā tvaparātmikā //"
  },
  {
   "ref": "AbhT_1.272",
   "ahnika": 1,
   "verse": 272,
   "text": "etatprāṇita evāyaṃ vyavahāraḥ pratāyate //"
  },
  {
   "ref": "AbhT_1.273",
   "ahnika": 1,
   "verse": 273,
   "text": "parasaṃbandharūpatvamabhisaṃbandhapañcake //"
  },
  {
   "ref": "AbhT_1.274",
   "ahnika": 1,
   "verse": 274,
   "text": "mahānavāntaro divyo miśro@nyo@nyastu pañcamaḥ //"
  },
  {
   "ref": "AbhT_1.275",
   "ahnika": 1,
   "verse": 275,
   "text": "saṃbandhaḥ paratā cāsya pūrṇaikātmyaprathāmayī //"
  },
  {
   "ref": "AbhT_1.276",
   "ahnika": 1,
   "verse": 276,
   "text": "śāstravācyaṃ phalādīnāṃ paripūrṇatvayogataḥ //"
  },
  {
   "ref": "AbhT_1.277",
   "ahnika": 1,
   "verse": 277,
   "text": "uddeśāditrayaprāṇā sarvaśāstrasvarūpiṇī //"
  },
  {
   "ref": "AbhT_1.278",
   "ahnika": 1,
   "verse": 278,
   "text": "vijñānabhidgatopāyaḥ paropāyastṛtīyakaḥ //"
  },
  {
   "ref": "AbhT_1.279",
   "ahnika": 1,
   "verse": 279,
   "text": "cakrodayo@tha deśādhvā tattvādhvā tattvabhedanam //"
  },
  {
   "ref": "AbhT_1.280",
   "ahnika": 1,
   "verse": 280,
   "text": "dīkṣopakramaṇaṃ dīkṣā sāmayī pautrike vidhau //"
  },
  {
   "ref": "AbhT_1.281",
   "ahnika": 1,
   "verse": 281,
   "text": "tulādīkṣātha pārokṣī liṅgoddhāro@bhiṣecanam //"
  },
  {
   "ref": "AbhT_1.282",
   "ahnika": 1,
   "verse": 282,
   "text": "liṅgārcā bahubhitparvapavitrādi nimittajam //"
  },
  {
   "ref": "AbhT_1.283",
   "ahnika": 1,
   "verse": 283,
   "text": "ekīkāraḥ svasvarūpe praveśaḥ śāstramelanam //"
  },
  {
   "ref": "AbhT_1.284",
   "ahnika": 1,
   "verse": 284,
   "text": "iti saptādhikāmenāṃ triṃśataṃ yaḥ sadā budhaḥ //"
  },
  {
   "ref": "AbhT_1.285",
   "ahnika": 1,
   "verse": 285,
   "text": "saptatriṃśatsu saṃpūrṇabodho yadbhairavo bhavet //"
  },
  {
   "ref": "AbhT_1.286",
   "ahnika": 1,
   "verse": 286,
   "text": "ityeṣa pūrvajoddeśaḥ kathyate tvanujo@dhunā //"
  },
  {
   "ref": "AbhT_1.287",
   "ahnika": 1,
   "verse": 287,
   "text": "dvitīyasminprakaraṇe gatopāyatvabheditā //"
  },
  {
   "ref": "AbhT_1.288",
   "ahnika": 1,
   "verse": 288,
   "text": "mantrādyabhinnarūpatvaṃ paropāye vivicyate //"
  },
  {
   "ref": "AbhT_1.289",
   "ahnika": 1,
   "verse": 289,
   "text": "yogāṅgānupayogitvaṃ kalpitārcādyanādaraḥ //"
  },
  {
   "ref": "AbhT_1.290",
   "ahnika": 1,
   "verse": 290,
   "text": "niṣedhavidhitulyatvaṃ śāktopāye@tra carcyate //"
  },
  {
   "ref": "AbhT_1.291",
   "ahnika": 1,
   "verse": 291,
   "text": "uccāraḥ paratattvāntaḥpraveśapathalakṣaṇam //"
  },
  {
   "ref": "AbhT_1.292",
   "ahnika": 1,
   "verse": 292,
   "text": "cāramānamahorātrasaṃkrāntyādivikalpanam //"
  },
  {
   "ref": "AbhT_1.293",
   "ahnika": 1,
   "verse": 293,
   "text": "cakrabhinmantravidyābhidetaccakrodaye bhavet //"
  },
  {
   "ref": "AbhT_1.294",
   "ahnika": 1,
   "verse": 294,
   "text": "etaddeśādhvanirdeśe dvayaṃ tattvādhvanirṇaye //"
  },
  {
   "ref": "AbhT_1.295",
   "ahnika": 1,
   "verse": 295,
   "text": "vastudharmastattvavidhirjāgradādinirūpaṇam //"
  },
  {
   "ref": "AbhT_1.296",
   "ahnika": 1,
   "verse": 296,
   "text": "kalāsvarūpamekatripañcādyaistattvakalpanam //"
  },
  {
   "ref": "AbhT_1.297",
   "ahnika": 1,
   "verse": 297,
   "text": "kalādyadhvavicārāntaretāvatpravivicyate //"
  },
  {
   "ref": "AbhT_1.298",
   "ahnika": 1,
   "verse": 298,
   "text": "saṃkhyādhikyaṃ malādīnāṃ tattvaṃ śaktivicitratā //"
  },
  {
   "ref": "AbhT_1.299",
   "ahnika": 1,
   "verse": 299,
   "text": "śaktipātaparīkṣāyāmetāvānvācyasaṃgrahaḥ //"
  },
  {
   "ref": "AbhT_1.300",
   "ahnika": 1,
   "verse": 300,
   "text": "utkrāntyanupayogitvaṃ dīkṣopakramaṇe sthitam //"
  },
  {
   "ref": "AbhT_1.301",
   "ahnika": 1,
   "verse": 301,
   "text": "sāmānyanyāsabhedo@rghapātraṃ caitatprayojanam //"
  },
  {
   "ref": "AbhT_1.302",
   "ahnika": 1,
   "verse": 302,
   "text": "praveśo diksvarūpaṃ ca dehaprāṇādiśodhanam //"
  },
  {
   "ref": "AbhT_1.303",
   "ahnika": 1,
   "verse": 303,
   "text": "dehapūjā prāṇabuddhicitsvadhvanyāsapūjane //"
  },
  {
   "ref": "AbhT_1.304",
   "ahnika": 1,
   "verse": 304,
   "text": "kṣetragrahaḥ pañcagavyaṃ pūjanaṃ bhūgaṇeśayoḥ //"
  },
  {
   "ref": "AbhT_1.305",
   "ahnika": 1,
   "verse": 305,
   "text": "tarpaṇaṃ carusaṃsiddhirdantakāṣṭhāntasaṃskriyā //"
  },
  {
   "ref": "AbhT_1.306",
   "ahnika": 1,
   "verse": 306,
   "text": "svapnasya sāmayaṃ karma samayāśceti saṃgrahaḥ //"
  },
  {
   "ref": "AbhT_1.307",
   "ahnika": 1,
   "verse": 307,
   "text": "maṇḍalātmānusandhānaṃ nivedyapaśuvistaraḥ //"
  },
  {
   "ref": "AbhT_1.308",
   "ahnika": 1,
   "verse": 308,
   "text": "adhvanyāsavidhiḥ śodhyaśodhakādivicitratā //"
  },
  {
   "ref": "AbhT_1.309",
   "ahnika": 1,
   "verse": 309,
   "text": "bhedo yojanikādeśca ṣoḍaśe syādihāhnike //"
  },
  {
   "ref": "AbhT_1.310",
   "ahnika": 1,
   "verse": 310,
   "text": "adhvabhedastathetyevaṃ kathitaṃ pautrike vidhau //"
  },
  {
   "ref": "AbhT_1.311",
   "ahnika": 1,
   "verse": 311,
   "text": "iti saṃkṣiptadīkṣākhye syādaṣṭādaśa āhnike //"
  },
  {
   "ref": "AbhT_1.312",
   "ahnika": 1,
   "verse": 312,
   "text": "brahmavidyāvidhiścaivamuktaṃ sadyaḥsamutkrame //"
  },
  {
   "ref": "AbhT_1.313",
   "ahnika": 1,
   "verse": 313,
   "text": "ityetadvācyasarvasvaṃ syādviṃśatitamāhnike //"
  },
  {
   "ref": "AbhT_1.314",
   "ahnika": 1,
   "verse": 314,
   "text": "balābalavicāraścetyekaviṃśāhnike vidhiḥ //"
  },
  {
   "ref": "AbhT_1.315",
   "ahnika": 1,
   "verse": 315,
   "text": "śaṅkāccheda iti spaṣṭaṃ vācyaṃ liṅgoddhṛtikrame //"
  },
  {
   "ref": "AbhT_1.316",
   "ahnika": 1,
   "verse": 316,
   "text": "tadvibhāgaḥ sādhakatvamabhiṣekavidhau tviyat //"
  },
  {
   "ref": "AbhT_1.317",
   "ahnika": 1,
   "verse": 317,
   "text": "caturviṃśe@ntyayāgākhye vaktavyaṃ paricarcyate //"
  },
  {
   "ref": "AbhT_1.318",
   "ahnika": 1,
   "verse": 318,
   "text": "pañcaviṃśāhnike śrāddhaprakāśe vastusaṃgrahaḥ //"
  },
  {
   "ref": "AbhT_1.319",
   "ahnika": 1,
   "verse": 319,
   "text": "liṅgasvarūpaṃ bahudhā cākṣasūtranirūpaṇam //"
  },
  {
   "ref": "AbhT_1.320",
   "ahnika": 1,
   "verse": 320,
   "text": "naimittikavibhāgastatprayojanavidhistataḥ //"
  },
  {
   "ref": "AbhT_1.321",
   "ahnika": 1,
   "verse": 321,
   "text": "gurvādyantadinādyarcāprayojananirūpaṇam //"
  },
  {
   "ref": "AbhT_1.322",
   "ahnika": 1,
   "verse": 322,
   "text": "vyākhyāvidhiḥ śrutavidhirgurupūjāvidhistviyat //"
  },
  {
   "ref": "AbhT_1.323",
   "ahnika": 1,
   "verse": 323,
   "text": "adhikāryātmano bhedaḥ siddhapatnīkulakramaḥ //"
  },
  {
   "ref": "AbhT_1.324",
   "ahnika": 1,
   "verse": 324,
   "text": "dīkṣābhiṣekau bodhaścetyekonatriṃśa āhnike //"
  },
  {
   "ref": "AbhT_1.325",
   "ahnika": 1,
   "verse": 325,
   "text": "śūlābjabhedo vyomaśasvastikādinirūpaṇam //"
  },
  {
   "ref": "AbhT_1.326",
   "ahnika": 1,
   "verse": 326,
   "text": "guṇapradhānatābhedāḥ svarūpaṃ vīryacarcanam //"
  },
  {
   "ref": "AbhT_1.327",
