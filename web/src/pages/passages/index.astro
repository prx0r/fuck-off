---
// passages/index.astro — the 49 published IPVV passages (real corpus)
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';
const dir = path.join(process.cwd(), '..', 'site');
const manifest = JSON.parse(fs.readFileSync(path.join(dir, 'manifest.json'), 'utf-8'));
const passages = manifest.passages?.passages || [];
---
<Layout title="Passages — Pāṭala" description="The 49 published IPVV reading passages" jsonLd={{ "@context":"https://schema.org", "@type":"CollectionPage", name:"Pāṭala IPVV Passages" }}>
  <h1>Published IPVV Passages</h1>
  <p>{passages.length} published passages.</p>
  <ul>
    {passages.map(p => (
      <li>
        <strong>{p.locator || p.id}</strong>
        {p.reading && <p class="ceiling">{p.reading}…</p>}
        {p.has_c1 && <span class="ceiling"> · has commentary</span>}
      </li>
    ))}
  </ul>
</Layout>
