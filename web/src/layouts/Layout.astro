---
// Layout.astro — the 0-JS semantic shell (canonical + JSON-LD, no client JS)
export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  jsonLd?: Record<string, unknown>;
}
const { title, description = '', canonical, jsonLd } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title} — Pāṭala</title>
  <meta name="description" content={description}>
  {canonical && <link rel="canonical" href={canonical}>}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
  <style is:inline>
    body{font-family:system-ui,sans-serif;max-width:820px;margin:2rem auto;padding:0 1rem;line-height:1.6;color:#1a1a1a}
    a{color:#0066cc;text-decoration:none}a:hover{text-decoration:underline}
    nav a{margin-right:1rem}.ceiling{color:#666;font-size:.85rem}ul{list-style:none;padding-left:0}
    ul li{padding:.25rem 0;border-bottom:1px solid #eee}
  </style>
</head>
<body>
  <nav><a href="/">Home</a><a href="/concepts/">Concepts</a><a href="/sitemap.xml">Sitemap</a></nav>
  <main><slot /></main>
</body>
</html>
